{
  "name": "dsh-movable-settings",
  "version": "1.1.0",
  "description": "Make the DSH settings dialog movable, resizable and maximizable, remembering its geometry.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zangxx66/dsh-movable-settings.git",
    "directory": "plugins/dsh-movable-settings"
  },
  "homepage": "https://github.com/zangxx66/dsh-movable-settings#readme",
  "bugs": {
    "url": "https://github.com/zangxx66/dsh-movable-settings/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "settings",
    "dialog",
    "floating-window",
    "draggable",
    "resizable",
    "ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/enhancer.test.mjs test/manifest.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
